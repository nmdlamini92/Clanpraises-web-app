generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mobcomment {
  id      String @id @default(uuid())
  message String
  userID  String
  clan    String
}

model User1 {
  id            String                  @id @default(uuid())
  username      String?                 
  tribe         String?
  email         String                  @unique
  password      String?
  createdAt     DateTime                @default(now())
  clan          String?
  googleId      String?                 @unique
  facebookId    String?                 @unique
  comments      Comment[]
  definitions   Definition[]
  disLikeCom    DisLike_on_Comment[]
  disLikeDef    DisLike_on_Definition[]
  disLikesRev   DisLike_on_Review[]
  followedPosts Follwings_on_Post[]
  likesCP       Like_on_ClanPraise[]
  likesCom      Like_on_Comment[]
  likesDef      Like_on_Definition[]
  likes         Like_on_Review[]
  post          Post[]
  reviews       Review[]
}

model Tribe {
  id               String  @id @default(uuid())
  tribe            String  @unique
  praises_Plural   String  @default("clanpraises")
  praises_Singular String?
  clanpraises      Post[]
}

model Post {
  id              String               @id @default(uuid())
  title           String
  body            String
  tribe           String
  userId          String
  createdAt       DateTime?            @default(now())
  tribeId         String?
  location        String?
  related         String?
  forbidden_foods String?
  bodyEnglish     String?
  bodySiswati     String?
  comments        Comment[]
  definitions     Definition[]
  Followers       Follwings_on_Post[]
  likesCP         Like_on_ClanPraise[]
  tribe_          Tribe?               @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  user            User1                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports         Report[]
  reviews         Review[]
  views           Views[]
}

model User {
  id       String  @id @default(uuid())
  password String
  username String? 
  email    String? @unique(map: "users_email_unique") @db.VarChar(20)
}

model Review {
  id           String              @id @default(uuid())
  message      String
  rating       Int?
  index        Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  userId       String
  postId       String
  parentId     String?
  definitionId String?
  page         Int?
  disLikes     DisLike_on_Review[]
  likes        Like_on_Review[]
  reports      Report[]
  definition   Definition?         @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  parent       Review?             @relation("ParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children     Review[]            @relation("ParentChild")
  post         Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User1               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id           String               @id @default(uuid())
  message      String
  rating       Int?
  index        Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userId       String
  postId       String
  parentId     String?
  definitionId String?
  page         Int?
  definition   Definition?          @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  parent       Comment?             @relation("ParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children     Comment[]            @relation("ParentChild")
  post         Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User1                @relation(fields: [userId], references: [id], onDelete: Cascade)
  disLikes     DisLike_on_Comment[]
  likes        Like_on_Comment[]
  reports      Report[]
}

model Definition {
  id        String                  @id @default(uuid())
  message   String
  rating    Float?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  userId    String
  postId    String
  parentId  String?
  index     Int
  page      Int?
  comments  Comment[]
  parent    Definition?             @relation("ParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children  Definition[]            @relation("ParentChild")
  post      Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User1                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  disLikes  DisLike_on_Definition[]
  likes     Like_on_Definition[]
  reports   Report[]
  reviews   Review[]
}

model TrashCan_ClanPraises {
  id          String   @id @default(uuid())
  tribe       String
  clan        String
  body        String
  comments    String
  definitions String
  reviews     String
  createdAt   DateTime @default(now())
}

model TrashCan_Definitions {
  id           String   @id @default(uuid())
  body         String
  clan         String
  clanPraiseId String
  comments     String
  reviews      String
  tribe        String
  createdAt    DateTime @default(now())
}

model Report {
  id           String      @id @default(uuid())
  type         String?
  message      String
  Status       String?
  userId       String?
  postId       String?
  commentId    String?
  reviewId     String?
  definitionId String?
  createdAt    DateTime    @default(now())
  comment      Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  definition   Definition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  post         Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  review       Review?     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(uuid())
  message   String
  email     String
  createdAt DateTime @default(now())
}

model Like_on_ClanPraise {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User1  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Views {
  postId    String
  createdAt DateTime? @default(now())
  vieweeId  String
  id        String    @id @default(uuid())
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Follwings_on_Post {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User1  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Like_on_Definition {
  userId       String
  definitionId String
  createdAt    DateTime?  @default(now())
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  user         User1      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, definitionId])
}

model DisLike_on_Definition {
  userId       String
  definitionId String
  createdAt    DateTime?  @default(now())
  definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  user         User1      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, definitionId])
}

model Like_on_Review {
  userId    String
  reviewId  String
  createdAt DateTime? @default(now())
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User1     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

model DisLike_on_Review {
  userId    String
  reviewId  String
  createdAt DateTime? @default(now())
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User1     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

model Like_on_Comment {
  userId    String
  commentId String
  createdAt DateTime? @default(now())
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User1     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model DisLike_on_Comment {
  userId    String
  commentId String
  createdAt DateTime? @default(now())
  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User1     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model recently_trending {
  id           String   @id @default(uuid())
  clanPraiseId String
  rank         Int?
  createdAt    DateTime @default(now())
}

model UserAnalytics {
  id         String   @id @default(uuid())
  ip         String
  date       DateTime
  deviceType String
  country    String?
  region     String?
  city       String?
  createdAt  DateTime @default(now())

  @@unique([ip, date])
}
